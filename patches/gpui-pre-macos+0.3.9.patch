+/// Holds up a quit from outside the app, like the Dock's or logging out's, until the app has said
+/// whether it goes ahead. AppKit turns down any other quit from outside in the meantime, and
+/// passes on the answer to whoever asked, so a no cancels a logout too.
+extern "C" fn should_terminate(this: &mut Object, _: Sel, _: id) -> NSUInteger {
+    let platform = unsafe { get_mac_platform(this) };
+    let mut lock = platform.0.lock();
+    let Some(mut callback) = lock.quit_requested.take() else {
+        return NSApplicationTerminateReply::NSTerminateNow as NSUInteger;
+    };
+    drop(lock);
+    callback(Box::new(|quit| unsafe {
+        let app = NSApplication::sharedApplication(nil);
+        let _: () = msg_send![app, replyToApplicationShouldTerminate: quit.to_objc()];
+    }));
+    platform.0.lock().quit_requested.get_or_insert(callback);
+    NSApplicationTerminateReply::NSTerminateLater as NSUInteger
+}
+
 extern "C" fn will_terminate(this: &mut Object, _: Sel, _: id) {
     let platform = unsafe { get_mac_platform(this) };
     let mut lock = platform.0.lock();
