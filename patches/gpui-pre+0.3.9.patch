+    /// Where `line`'s last word starts, with the extension after it: "0012.jpeg" in
+    /// "IMG_0012.jpeg", "(3).png" in "photo (3).png", "Support" in "Application Support". A line
+    /// that's one word throughout keeps just its extension.
+    fn tail_start(line: &str) -> usize {
+        let is_break = |c: char| c.is_whitespace() || matches!(c, '_' | '-' | '/');
+        let end = match line.rfind('.') {
+            Some(ix) if ix > 0 && !line[ix..].contains(is_break) => ix,
+            _ => line.len(),
+        };
+        match line[..end]
+            .trim_end_matches(is_break)
+            .trim_end_matches(|c| !is_break(c))
+            .len()
+        {
+            0 => end,
+            start => start,
+        }
+    }
