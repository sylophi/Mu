+    /// Register a callback that decides whether to quit when something outside the app asks it
+    /// to, like the Dock or logging out. The quit waits for the future it returns, and doesn't
+    /// happen if that's false. [`App::quit`] isn't asked about, as the app has decided by then.
+    pub fn on_quit_requested<Fut>(&self, should_quit: impl Fn(&mut App) -> Fut + 'static)
+    where
+        Fut: 'static + Future<Output = bool>,
+    {
+        let cx = self.to_async();
+        let should_quit = Rc::new(should_quit);
+        self.platform.on_quit_requested(Box::new(move |reply| {
+            let should_quit = should_quit.clone();
+            // Not right here, as the platform can ask while the app is borrowed.
+            cx.spawn(async move |cx| {
+                let answer = cx.update(|cx| should_quit(cx));
+                reply(answer.await);
+            })
+            .detach();
+        }));
+    }
