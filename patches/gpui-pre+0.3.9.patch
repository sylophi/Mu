             _ => self.last_input_modality,
         };
-        if self.last_input_modality != old_modality {
-            self.refresh();
-        }
+        // Refreshed after the event's dispatched, not before, since a key press dispatched into a
+        // window that needs drawing draws it first, and so a key press after the mouse drew twice.
+        let modality_changed = self.last_input_modality != old_modality;
 
